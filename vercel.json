{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/manifest.json",
      "dest": "api/index.js"
    },
    {
      "src": "/meta",
      "dest": "api/index.js?type=meta"
    },
    {
      "src": "/stream",
      "dest": "api/index.js?type=stream"
    }
  ]
}
